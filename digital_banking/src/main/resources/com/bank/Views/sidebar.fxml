<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>

<BorderPane fx:id="bp" prefHeight="500.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank.Controllers.sidebarController">
   <!-- Menu latéral -->
   <left>
      <Pane BorderPane.alignment="CENTER">
         <children>
            <VBox prefHeight="474.0" prefWidth="200.0" style="-fx-background-color: linear-gradient(to bottom, #2980b9, #1a5276);">
               <children>
                  <!-- Logo -->
                  <ImageView fitHeight="120.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../img/building.jpg" />
                     </image>
                     <effect>
                        <DropShadow radius="10.0" color="black"/>
                     </effect>
                  </ImageView>

                  <!-- Boutons du menu -->
                  <Button alignment="BOTTOM_LEFT" mnemonicParsing="false" onMouseClicked="#home" prefHeight="40.0" prefWidth="210.0"
                          style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 0px 0px 2px 0px; -fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;">
                     Home
                  </Button>
                  <Button alignment="BOTTOM_LEFT" mnemonicParsing="false" onMouseClicked="#transactions" prefHeight="40.0" prefWidth="210.0"
                          style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 0px 0px 2px 0px; -fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;">
                     Transactions
                  </Button>
                  <Button alignment="BOTTOM_LEFT" mnemonicParsing="false" onMouseClicked="#clients" prefHeight="40.0" prefWidth="210.0"
                          style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 0px 0px 2px 0px; -fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;">
                     Clients
                  </Button>
                  <Button alignment="BOTTOM_LEFT" mnemonicParsing="false" onMouseClicked="#comptes" prefHeight="40.0" prefWidth="210.0"
                          style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 0px 0px 2px 0px; -fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;">
                     Comptes
                  </Button>
                  <Region prefHeight="148.0" prefWidth="200.0" />
               </children>
            </VBox>
         </children>
      </Pane>
   </left>

   <!-- Contenu central -->
   <center>
      <AnchorPane fx:id="ap" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: white;" BorderPane.alignment="CENTER">
         <children>
            <StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" />
         </children>
      </AnchorPane>
   </center>

   <!-- Barre supérieure -->
   <top>
      <Pane prefHeight="50.0" prefWidth="900.0" style="-fx-background-color: #1a5276; -fx-padding: 10;" BorderPane.alignment="CENTER">
         <children>
            <Label layoutX="400.0" layoutY="10.0" prefHeight="30.0" prefWidth="200.0" text="Bank System" textFill="WHITE">
               <font>
                  <Font name="Arial Black" size="22.0" />
               </font>
            </Label>
         </children>
      </Pane>
   </top>
</BorderPane>
