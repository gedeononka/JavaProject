<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Separator?>

<AnchorPane prefHeight="478.0" prefWidth="711.0" style="-fx-background-color: linear-gradient(to bottom, #2c3e50, #2980b9);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank.Controllers.LoginController">
    <children>
        <!-- Titre principal -->
        <Label layoutX="120.0" layoutY="50.0" prefHeight="100.0" prefWidth="470.0" text="Digital Bank" textAlignment="CENTER" textFill="WHITE">
            <font>
                <Font name="Arial Black" size="65.0" />
            </font>
        </Label>

        <!-- Sous-titre -->
        <Label layoutX="140.0" layoutY="160.0" prefHeight="50.0" prefWidth="450.0" text="Gedeon Banking System" textAlignment="CENTER" textFill="WHITE">
            <font>
                <Font name="Arial" size="28.0" />
            </font>
        </Label>

        <!-- Ligne de séparation -->
        <Separator layoutX="150.0" layoutY="220.0" prefHeight="3.0" prefWidth="400.0" style="-fx-background-color: white;" />

        <!-- Label Username -->
        <Label layoutX="171.0" layoutY="260.0" text="Username:" textFill="WHITE">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <!-- Champ Username -->
        <TextField layoutX="171.0" layoutY="285.0" prefWidth="370.0" fx:id="usernameField" promptText="Enter your username"/>

        <!-- Label Password -->
        <Label layoutX="171.0" layoutY="325.0" text="Password:" textFill="WHITE">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <!-- Champ Password -->
        <PasswordField layoutX="171.0" layoutY="350.0" prefWidth="370.0" fx:id="passwordField" promptText="Enter your password"/>

        <!-- Bouton Connexion -->
        <Button layoutX="171.0" layoutY="400.0" text="Login" prefWidth="170.0" style="-fx-background-color: #27ae60; -fx-text-fill: white;" fx:id="loginButton" onAction="#handleLogin"/>

        <!-- Bouton Création -->
        <Button layoutX="371.0" layoutY="400.0" text="Create" prefWidth="170.0" style="-fx-background-color: #2980b9; -fx-text-fill: white;" fx:id="createButton" onAction="#handleCreate"/>
    </children>
</AnchorPane>
