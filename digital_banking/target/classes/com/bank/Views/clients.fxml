<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Separator?>

<Pane prefHeight="460.0" prefWidth="630.0" style="-fx-background-color: linear-gradient(to bottom, #2c3e50, #2980b9);"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank.Controllers.clientController">

   <!-- Titre Principal -->
   <Label layoutX="20.0" layoutY="15.0" text="Gestion des Clients" textFill="WHITE">
      <font>
         <Font size="28.0" />
      </font>
   </Label>

   <!-- Ligne de séparation -->
   <Separator layoutX="20.0" layoutY="50.0" prefHeight="3.0" prefWidth="590.0" style="-fx-background-color: white;" />

   <!-- Table des clients -->
   <TableView fx:id="tv_clients" layoutX="20.0" layoutY="70.0" onMouseClicked="#onTableItemSelect" prefHeight="250.0" prefWidth="590.0">
      <columns>
         <TableColumn fx:id="tc_id" prefWidth="70.0" text="CIN" />
         <TableColumn fx:id="tc_np" prefWidth="130.0" text="Nom &amp; Prénom" />
         <TableColumn fx:id="tc_dn" prefWidth="120.0" text="Date de naissance" />
         <TableColumn fx:id="tc_tel" prefWidth="80.0" text="Téléphone" />
         <TableColumn fx:id="tc_em" prefWidth="90.0" text="Email" />
         <TableColumn fx:id="tc_adr" prefWidth="100.0" text="Adresse" />
      </columns>
   </TableView>

   <!-- Zone de recherche -->
   <TextField fx:id="tf_cin" layoutX="220.0" layoutY="330.0" prefHeight="25.0" prefWidth="230.0" promptText="Entrer le CIN à rechercher" />
   <Button fx:id="btn_search" layoutX="460.0" layoutY="330.0" mnemonicParsing="false" onAction="#searchClient"
           prefHeight="25.0" prefWidth="100.0" text="Rechercher"
           style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 13px;" />

   <!-- Zone de modification -->
   <Label layoutX="20.0" layoutY="370.0" text="CIN :" textFill="WHITE" />
   <Label fx:id="labelid" layoutX="70.0" layoutY="370.0" prefHeight="20.0" prefWidth="100.0" textFill="WHITE" />
   <TextField fx:id="tf_sel_tel" layoutX="180.0" layoutY="370.0" prefHeight="25.0" prefWidth="120.0" promptText="Téléphone" />
   <TextField fx:id="tf_sel_email" layoutX="310.0" layoutY="370.0" prefHeight="25.0" prefWidth="130.0" promptText="Email" />
   <TextField fx:id="tf_sel_adr" layoutX="450.0" layoutY="370.0" prefHeight="25.0" prefWidth="140.0" promptText="Adresse" />

   <!-- Boutons d'action -->
   <Button fx:id="btn_ajouter" layoutX="20.0" layoutY="415.0" mnemonicParsing="false" onAction="#ajouterclt"
           prefHeight="35.0" prefWidth="110.0" text="➕ Ajouter"
           style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px;" />

   <Button layoutX="140.0" layoutY="415.0" mnemonicParsing="false" onAction="#onUpdateClt"
           prefHeight="35.0" prefWidth="110.0" text="✏ Modifier"
           style="-fx-background-color: #f1c40f; -fx-text-fill: black; -fx-font-size: 14px;" />

   <Button layoutX="260.0" layoutY="415.0" mnemonicParsing="false" onAction="#deleteClient"
           prefHeight="35.0" prefWidth="110.0" text="🗑 Supprimer"
           style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px;" />

   <Button layoutX="500.0" layoutY="15.0" mnemonicParsing="false" onAction="#load_page"
           prefHeight="30.0" prefWidth="90.0" text="🔄 Charger"
           style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 13px;" />

</Pane>
