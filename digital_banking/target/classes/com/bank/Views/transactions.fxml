<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<Pane prefHeight="431.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bank.Controllers.transactionController">
   <VBox spacing="10" padding="10">
      <Label text="Gestion des Transactions" textFill="#2980b9"
             style="-fx-font-size: 33px; -fx-font-weight: bold; -fx-alignment: center;"/>

      <TabPane prefHeight="400.0" prefWidth="700.0" tabClosingPolicy="UNAVAILABLE">
         <Tab text="Transactions">
            <VBox spacing="10" padding="10">
               <HBox spacing="10">
                  <Label text="Dépôt" textFill="#2980b9" style="-fx-font-size: 18px;"/>
                  <Button fx:id="btn_load" text="Load" textFill="WHITE"
                          style="-fx-background-color: #2980b9; -fx-font-size: 14px;"/>
               </HBox>

               <TableView fx:id="tv_depot" prefHeight="120">
                  <columns>
                     <TableColumn fx:id="tc_dep_op" text="Numéro"/>
                     <TableColumn fx:id="tc_dep_date" text="Date" prefWidth="100"/>
                     <TableColumn fx:id="tc_dep_mnt" text="Montant" prefWidth="150"/>
                     <TableColumn fx:id="tc_dep_em" text="N° compte" prefWidth="130"/>
                  </columns>
               </TableView>
               <Button layoutX="611.0" text="Save" onAction="#saveDepotPDF"/>

               <HBox spacing="10">
                  <Label text="Retrait" textFill="#2980b9" style="-fx-font-size: 18px;"/>
               </HBox>

               <TableView fx:id="tv_retrait" prefHeight="120">
                  <columns>
                     <TableColumn fx:id="tc_ret_op" text="Numéro"/>
                     <TableColumn fx:id="tc_ret_date" text="Date" prefWidth="100"/>
                     <TableColumn fx:id="tc_ret_mnt" text="Montant" prefWidth="150"/>
                     <TableColumn fx:id="tc_ret_em" text="N° compte" prefWidth="130"/>
                  </columns>
               </TableView>
               <Button layoutX="611.0" text="Save" onAction="#saveRetraitPDF"/>
            </VBox>
         </Tab>

         <Tab text="Dépôt">
            <VBox spacing="10" padding="10">
               <Text text="Dépôt" fill="#2980b9" style="-fx-font-size: 21px; -fx-font-weight: bold;"/>
               <TextField fx:id="tf_num1" promptText="N° Compte à créditer"/>
               <TextField fx:id="tf_mnt1" promptText="Montant à créditer"/>
               <Button fx:id="btn_search1" text="Chercher"/>
               <Button fx:id="btn_conf1" text="Confirmer" textFill="WHITE"
                       style="-fx-background-color: #2980b9;"/>
            </VBox>
         </Tab>

         <Tab text="Retrait">
            <VBox spacing="10" padding="10">
               <Text text="Retrait" fill="#2980b9" style="-fx-font-size: 21px; -fx-font-weight: bold;"/>
               <TextField fx:id="tf_num2" promptText="N° Compte à débiter"/>
               <TextField fx:id="tf_mnt2" promptText="Montant à débiter"/>
               <Button fx:id="btn_search2" text="Chercher"/>
               <Button fx:id="btn_conf2" text="Confirmer" textFill="WHITE"
                       style="-fx-background-color: #2980b9;"/>
            </VBox>
         </Tab>
      </TabPane>
   </VBox>
</Pane>
